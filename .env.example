# Copy this file to .env (same folder as server.js) and fill in ONE of the sections below.
# .env is git-ignored, so the key stays on this machine. Restart `npm start` after editing.
# Without any key everything works except "make a ___" / "make the handle bigger".
#
# With several keys set, the server uses the first it finds: OpenAI, then Anthropic, then AWS.
# Force one with:
# AI_PROVIDER=openai            # openai | anthropic | bedrock

# ---- OpenAI ----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=low   # optional, lower = faster: none | minimal | low | medium | high

# ---- Anthropic API (Claude) ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ---- AWS: Claude on Amazon Bedrock ----
# First enable model access for Anthropic Claude in the Bedrock console, in the region below.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# ...or a Bedrock API key instead of the two lines above:
# AWS_BEARER_TOKEN_BEDROCK=...
# BEDROCK_MODEL=anthropic.claude-opus-5

# For either Claude option: lower = faster, higher = more careful. Default is high.
# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max

# ---- Blender mode (npm run blender) ----
# Needs ANTHROPIC_API_KEY above. Claude writes Blender Python, looks at renders of the result, and fixes it.
# A model typically costs $0.30-$3 depending on detail.
# BLENDER_MODEL=claude-fable-5-1   # or claude-opus-5: about half the price, a bit less careful
# BLENDER_EFFORT=high              # low | medium | high | xhigh | max  (lower = faster and cheaper)
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 5.2/blender.exe   # only if Blender is somewhere else
# BLENDER_RESEARCH=off             # on by default: web search for specific real things ($0.01 a search)

# ---- Integrations: each one switches on by itself when its key is here. Run `npm run check` to test them. ----
# Version history in MongoDB Atlas (otherwise it's kept in local files under ~/.holomodel/history).
# Atlas: Connect > Drivers > copy the connection string; allow your IP under Network Access.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=holomodel

# ElevenLabs: Scribe v2 hears you (any browser, not just Edge), and a real voice answers.
# Otherwise the page uses Edge's own speech recognition and voice.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # optional; any voice ID from your ElevenLabs voice library

# Sentry: errors, performance traces, AI agent monitoring of every Fable build, session replay, hand-mouse profiling.
# SENTRY_DSN=https://...@o000000.ingest.us.sentry.io/0000000

# OpenAI textures (generate_texture tool for Fable): set OPENAI_API_KEY above and implement server/textures.js.

# PORT=8765

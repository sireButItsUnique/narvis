{
  "name": "holomodel",
  "version": "0.1.0",
  "private": true,
  "description": "Say what you want and Claude models it in a hidden Blender; then sculpt it in the browser with your hands, the way Blender sculpts.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "node --import ./server/instrument.js server.js",
    "test": "node --test",
    "test:blender": "node server/blender-process.js --python-exit-code 1 --python blender/test_bridge.py",
    "vendor": "node scripts/vendor.mjs",
    "parity:ref": "node server/blender-process.js --python scripts/blender-ref.py -- test/fixtures/blender-ref",
    "check": "node scripts/check-integrations.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@sentry/node": "^10.75.0",
    "@sentry/profiling-node": "^10.75.0",
    "mongodb": "^7.6.0",
    "openai": "^7.19.0",
    "three": "0.170.0"
  }
}
